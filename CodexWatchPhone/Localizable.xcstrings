    "iPhone creates a local notification when a task completes, fails, needs approval, or waits for input. Apple decides whether it appears on iPhone or Apple Watch.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone creates a local notification when a task completes, fails, needs approval, or waits for input. Apple decides whether it appears on iPhone or Apple Watch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任务完成、失败、需要审批或等待输入时，iPhone 会创建本地通知；系统会按照 Apple 的通知规则将它显示在 iPhone 或 Apple Watch 上。"
          }
        }
      }
    },
