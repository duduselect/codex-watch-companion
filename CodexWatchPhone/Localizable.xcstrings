    "For remote use, enter the Mac's private Tailscale address, such as ws://100.x.y.z:17842/codex-watch. Allow Local Network and notification access when prompted.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For remote use, enter the Mac's private Tailscale address, such as ws://100.x.y.z:17842/codex-watch. Allow Local Network and notification access when prompted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "人在外面时，请填写 Mac 的 Tailscale 私网地址，例如 ws://100.x.y.z:17842/codex-watch。首次连接时请允许本地网络和通知权限。"
          }
        }
      }
    },
    "If you can see this message, task notifications are enabled.": {
